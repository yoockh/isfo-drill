rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions
    match /sessions/{code} {
      // Siapa saja bisa READ session yang sudah published (peserta butuh ini)
      allow read: if resource.data.published == true;

      // Guru (authenticated) bisa read/update session miliknya sendiri
      allow read, update: if request.auth != null
                          && resource.data.createdBy == request.auth.uid;

      // Guru bisa membuat session baru
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;

      // Guru bisa menghapus session miliknya sendiri
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    // Attempts
    match /attempts/{attemptId} {
      // Siapa saja bisa CREATE attempt (peserta tidak login)
      allow create: if true;

      // Hanya user yang login bisa membaca attempts (guru melihat rekap)
      allow read: if request.auth != null;

      // Attempt tidak boleh diubah setelah dibuat
      allow update: if false;

      // Guru pemilik sesi terkait boleh menghapus attempt milik sesinya.
      // Kepemilikan diverifikasi dengan melihat dokumen sesi yang direferensikan.
      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/sessions/$(resource.data.sessionCode)).data.createdBy == request.auth.uid;
    }

    // Default: deny semua akses lain (mis. koleksi explanations & rateLimits
    // hanya boleh diakses server via Admin SDK)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
