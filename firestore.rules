rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions
    match /sessions/{code} {
      // Siapa saja bisa READ session yang sudah published (peserta butuh ini)
      allow read: if resource.data.published == true;

      // Guru (authenticated) bisa read/write session miliknya sendiri
      allow read, write: if request.auth != null
                         && resource.data.createdBy == request.auth.uid;

      // Guru bisa membuat session baru
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
    }

    // Attempts
    match /attempts/{attemptId} {
      // Siapa saja bisa CREATE attempt (peserta tidak login)
      allow create: if true;

      // Hanya user yang login bisa membaca attempts (guru melihat rekap)
      allow read: if request.auth != null;

      // Tidak ada yang bisa update/delete attempts
      allow update, delete: if false;
    }

    // Default: deny semua akses lain
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
